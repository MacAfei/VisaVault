# VisaVault Environment Variables
# Neon pooled connection URL for application traffic
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-POOLER-HOST/neondb?sslmode=require"
# Neon direct (non-pooled) connection URL for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST/neondb?sslmode=require"

# Google Gemini API
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Agency Dashboard Security
AGENCY_PASSWORD="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Demo Mode (true enables offline/instant mock extraction)
DEMO_MODE="false"

# Demo Fixed Date (Override system date for deterministic hackathon demo, format YYYY-MM-DD)
DEMO_TODAY=""
